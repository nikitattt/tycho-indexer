# Copy this file to .env and fill in the real values.
#
# The script treats this as a shell env file, so quote values that contain
# special characters.

# PostgreSQL connection. This matches the repo's docker-compose local DB.
# If running from inside Docker, use host "db" and port "5432" instead.
DATABASE_URL="postgresql://postgres:mypassword@localhost:5431/tycho_indexer_0"

# Railway bucket credentials from the bucket Credentials tab.
# You can either paste Railway's variable names here...
BUCKET="your-railway-bucket-name"
ACCESS_KEY_ID="your-access-key-id"
SECRET_ACCESS_KEY="your-secret-access-key"
REGION="auto"
ENDPOINT="https://storage.railway.app"

# ...or use these generic aliases instead.
# STORAGE_BUCKET="your-railway-bucket-name"
# STORAGE_ACCESS_KEY_ID="your-access-key-id"
# STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
# STORAGE_REGION="auto"
# STORAGE_ENDPOINT="https://storage.railway.app"

# Usually false for current Railway buckets. Set to true if Railway shows
# path-style access in the bucket Credentials tab.
STORAGE_FORCE_PATH_STYLE="false"

# Object names will look like:
# railway:<bucket>/<BACKUP_PREFIX>/<BACKUP_NAME>-<timestamp>.dump
BACKUP_PREFIX="postgres"
BACKUP_NAME="tycho-indexer"

# pg_dump custom-format compression. If your pg_dump does not support zstd,
# set this to a gzip level like "9".
PG_DUMP_COMPRESSION="zstd:9"

# Include a separate backup of roles/tablespaces/etc.
INCLUDE_GLOBALS="true"
GLOBALS_COMPRESSION="zstd"
GLOBALS_ZSTD_LEVEL="9"
GLOBALS_GZIP_LEVEL="9"

# Verify each uploaded object exists after rclone finishes.
VERIFY_UPLOAD="true"

# rclone S3 streaming uploads are limited to 10,000 parts. With 64 MiB parts,
# the max streamed object size is about 625 GiB.
S3_CHUNK_SIZE="64M"

# rclone in-memory remote name. You normally do not need to change this.
RCLONE_REMOTE="railway"
